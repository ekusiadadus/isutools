{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ekusiadadus/isutools/docs/schemas/external-analysis-v1.schema.json",
  "title": "isutools ExternalAnalysisArtifact v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "artifact_id", "kind", "generated_at", "analyzer", "status", "coverage", "budget"],
  "properties": {
    "schema": {"const": "isutools.external-analysis/v1"},
    "artifact_id": {"$ref": "#/$defs/sha256"},
    "kind": {"$ref": "#/$defs/token"},
    "generated_at": {"type": "string", "format": "date-time"},
    "analyzer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 64},
        "version": {"type": "string", "minLength": 1, "maxLength": 128},
        "revision": {"type": "string", "maxLength": 128}
      }
    },
    "status": {"enum": ["ready", "partial", "unsupported", "failed", "invalid"]},
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "snapshot_base", "snapshot_sha256", "snapshot_schema_version"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "snapshot_base": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^/\\\\]+$"},
        "snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "snapshot_schema_version": {"type": "integer", "minimum": 1}
      }
    },
    "inputs": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/file"}},
    "outputs": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/file"}},
    "executable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["match"],
      "properties": {
        "captured_sha256": {"$ref": "#/$defs/sha256"},
        "analyzed_sha256": {"$ref": "#/$defs/sha256"},
        "match": {"enum": ["verified", "mismatch", "unknown", "not-applicable"]},
        "go_version": {"type": "string", "maxLength": 128},
        "vcs_revision": {"type": "string", "maxLength": 128},
        "vcs_modified": {"type": "boolean"}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["complete"],
      "properties": {
        "complete": {"type": "boolean"},
        "clock": {"type": "string", "maxLength": 64},
        "started_at": {"type": "string", "format": "date-time"},
        "ended_at": {"type": "string", "format": "date-time"},
        "start_device": {"type": "integer", "minimum": 0},
        "start_inode": {"type": "integer", "minimum": 0},
        "start_offset": {"type": "integer", "minimum": 0},
        "end_device": {"type": "integer", "minimum": 0},
        "end_inode": {"type": "integer", "minimum": 0},
        "end_offset": {"type": "integer", "minimum": 0},
        "approximation_ns": {"type": "integer", "minimum": 0},
        "reason": {"type": "string", "maxLength": 128}
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeout_ms": {"type": "integer", "minimum": 0, "maximum": 600000},
        "max_input_bytes": {"type": "integer", "minimum": 0, "maximum": 1073741824},
        "max_output_bytes": {"type": "integer", "minimum": 0, "maximum": 1073741824},
        "max_memory_bytes": {"type": "integer", "minimum": 0, "maximum": 4294967296}
      }
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["level", "code", "message"],
        "properties": {
          "level": {"enum": ["info", "warn", "error"]},
          "code": {"$ref": "#/$defs/token"},
          "message": {"type": "string", "maxLength": 512}
        }
      }
    },
    "extensions": {
      "type": "object",
      "maxProperties": 8,
      "propertyNames": {"pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
      "additionalProperties": true
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "token": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "name", "sha256", "bytes", "media_type", "visibility"],
      "properties": {
        "role": {"$ref": "#/$defs/token"},
        "name": {"type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[^/\\\\]+$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 0, "maximum": 1073741824},
        "media_type": {"type": "string", "minLength": 1, "maxLength": 128},
        "visibility": {"enum": ["portable", "restricted"]},
        "truncated": {"type": "boolean"}
      }
    }
  }
}
