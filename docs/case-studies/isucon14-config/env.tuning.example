# Non-secret entries only. Merge them into /home/isucon/env.sh.
ISUCON_MATCHING_INTERVAL=0.5
ISUTOOLS_ROLE="app"
ISUTOOLS_NGINX_CONF="/etc/nginx/isutools-effective.conf"
ISUTOOLS_PROXY_CONF="/etc/nginx/isutools-effective.conf"
ISUTOOLS_PROXY_KIND="nginx"
ISUTOOLS_CGROUP_PATH="system.slice/isuride-go.service"

# Pin this to the deployed isutools source revision.
ISUTOOLS_GIT_HASH="replace-with-isutools-commit"
